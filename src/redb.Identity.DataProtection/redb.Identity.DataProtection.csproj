<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>redb.Identity.DataProtection</AssemblyName>
    <RootNamespace>redb.Identity.DataProtection</RootNamespace>
    <Description>redb-backed ASP.NET Core DataProtection key repository (RedbXmlRepository) for redb.Identity facades.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Phase 9 (9a): redb-backed ASP.NET DataProtection key repository, extracted from
      redb.Identity.Core so that any Identity facade (Http, gRPC, …) can persist its
      cookie / state-protector key-ring in redb without taking a project-reference on
      Core. Contains only the key XML repo + DI extension; everything that depends on
      RedbIdentityOptions (at-rest encryption, refresh route, lifecycle init) stays in
      Core where the option type lives.
    -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="9.0.4" />
    <!-- Direct override of a transitive dependency. Microsoft.AspNetCore.DataProtection 9.0.4 drags in
         System.Security.Cryptography.Xml 9.0.4, which carries SEVEN high-severity advisories
         (GHSA-23rf-6693-g89p, -37gx-xxp4-5rgx, -6588-8gv4-xfgh, -8q5v-6pqq-x66h, -cvvh-rhrc-wg4q,
         -g8r8-53c2-pm3f, -mmjf-rqrv-855v) and reached the PUBLISHED redb.Identity.DataProtection
         package. 9.0.18 is the patched 9.x release — the same version redb.Route.Soap already pins.
         Kept on 9.x rather than 10.x because these libraries multi-target down to net8.0. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="redb.Core" Version="4.0.0" />
  </ItemGroup>

</Project>

