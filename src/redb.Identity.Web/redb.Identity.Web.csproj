<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Directory.Build.props declares TargetFrameworks (plural) for the LIBRARIES. When both are
         set MSBuild takes the plural one, so a bare <TargetFramework> here is silently ignored and
         this project multi-targets anyway. Clearing it is what actually pins the single TFM. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>redb.Identity.Web</RootNamespace>
    <UserSecretsId>redb-identity-web-dev</UserSecretsId>
    <!-- Reference BFF application host — shipped as source in the public repo,
         not as a NuGet library (mirrors how redb.Tsak.Web/Worker are excluded). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The BFF is an application, not a library: its auth plumbing is internal on purpose, and the
         test project is the only consumer that needs to see it (PrincipalNaming). -->
    <InternalsVisibleTo Include="redb.Identity.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- BFF isolation: only Contracts + Client SDK, no server-side Identity refs -->
    <ProjectReference Include="..\redb.Identity.Contracts\redb.Identity.Contracts.csproj" />
    <ProjectReference Include="..\redb.Identity.Client\redb.Identity.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET packages follow the TFM (net10.0): a 9.0.x package on a 10.0 app is a stray, and it was
         the only reason this project resolved an older Microsoft.IdentityModel than the rest of Identity
         and the Tsak worker. From 10.0.10 these packages require IdentityModel >= 8.19.2: they move
         together with the ecosystem-wide IdentityModel version (Directory.Packages.props), never alone,
         or the ecosystem splits again (NU1605 on the older pin). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Direct override of transitive dependencies, same as redb.Identity.Http: the OpenIdConnect and
         JwtBearer handlers validate the OP tokens with these, and one IdentityModel version across
         Identity is the rule. The two roots below pull the rest of Microsoft.IdentityModel.* at that version. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
