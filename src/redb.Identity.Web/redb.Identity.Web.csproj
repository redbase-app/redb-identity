<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Directory.Build.props declares TargetFrameworks (plural) for the LIBRARIES. When both are
         set MSBuild takes the plural one, so a bare <TargetFramework> here is silently ignored and
         this project multi-targets anyway. Clearing it is what actually pins the single TFM. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>redb.Identity.Web</RootNamespace>
    <UserSecretsId>redb-identity-web-dev</UserSecretsId>
    <!-- Reference BFF application host — shipped as source in the public repo,
         not as a NuGet library (mirrors how redb.Tsak.Web/Worker are excluded). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- BFF isolation: only Contracts + Client SDK, no server-side Identity refs -->
    <ProjectReference Include="..\redb.Identity.Contracts\redb.Identity.Contracts.csproj" />
    <ProjectReference Include="..\redb.Identity.Client\redb.Identity.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET packages follow the TFM (net10.0): a 9.0.x package on a 10.0 app is a stray, and it was
         the only reason this project resolved Microsoft.IdentityModel 8.0.1 while the rest of Identity
         and the Tsak worker run 8.16.0. 10.0.9 on purpose, not the newest patch: from 10.0.10 these
         packages require IdentityModel >= 8.19.2, which would split the ecosystem again (NU1605 on a
         8.16.0 pin). Raise together with the ecosystem-wide IdentityModel move, not alone. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <!-- Direct override of transitive dependencies, same as redb.Identity.Http: the OpenIdConnect and
         JwtBearer handlers validate the OP tokens with these, and one IdentityModel version across
         Identity is the rule. The two roots below pull the rest of Microsoft.IdentityModel.* at 8.16.0. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.16.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
