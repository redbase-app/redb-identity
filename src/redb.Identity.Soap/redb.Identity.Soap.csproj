<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>redb.Identity.Soap</AssemblyName>
    <RootNamespace>redb.Identity.Soap</RootNamespace>
    <Description>WS-Trust facade for redb.Identity — Issue, Validate, Cancel and Renew over SOAP, on the same core routes as HTTP and gRPC.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Phase 8 invariant: a facade is project-reference-isolated from Core. Core and this facade exchange
      messages purely over `direct-vm://identity-*`, whose DTOs live in redb.Identity.Contracts.
      See doc/PHASE-8-FACADE-ISOLATION-PLAN-RU.md and doc/SOAP/ARCHITECTURE.md.
    -->
    <ProjectReference Include="..\redb.Identity.Contracts\redb.Identity.Contracts.csproj" />
    <PackageReference Include="redb.Route.Soap" Version="4.1.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="redb.Identity.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Module config template (Tsak Layer 4). Tsak loads this file by name "{Namespace}.config.json"
      alongside the assembly, or from inside the .tpkg. Copying to output ships it next to the DLL for
      both bare-DLL hot-reload and packaging.
    -->
    <None Update="redb.Identity.Soap.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Module\manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Wsdl\identity-sts.wsdl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!--
      Also embedded, and that is what the running service actually serves. Tsak loads a module's
      assembly straight from the .tpkg with LoadFromStream, so the assembly never lands on disk and
      Assembly.Location is empty there: a file next to the assembly cannot be found because there is
      no "next to". The loose copy above stays for tests, for a plain file deployment, and so that
      anyone can read the contract out of the package without running anything.
    -->
    <EmbeddedResource Include="Wsdl\identity-sts.wsdl" />
  </ItemGroup>

</Project>

