<Project>
  <!--
    Central package versions for every redb.Identity project (and for the public redb-identity mirror, which
    carries this file next to Directory.Build.props). Projects name a package without a version; the version
    lives here.

    Versions shared with other redb modules (Microsoft.Extensions.*, Microsoft.AspNetCore.*, Microsoft.IdentityModel.*,
    Serilog, the test stack) are written in each module's own Directory.Packages.props and must stay equal across
    them: an Identity module loads into the Tsak worker next to the worker's own copies.

    The packages that guard security (System.Security.Cryptography.Xml / .Pkcs, MailKit / MimeKit, MessagePack,
    the SignalR client) get their PackageVersion from the redb security baseline (Directory.Build.targets at the
    repository root) and nowhere else: this file must not list them (NU1506 is an error).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- OpenIddict: one version for every package of the stack. -->
  <ItemGroup>
    <PackageVersion Include="OpenIddict.Abstractions" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.Core" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.Server" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.Validation" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.Validation.DataProtection" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.Validation.ServerIntegration" Version="7.7.2" />
  </ItemGroup>

  <!-- Microsoft.IdentityModel.* and System.IdentityModel.Tokens.Jwt: one version, the one the Tsak worker runs on. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <!-- Microsoft.AspNetCore.* and Microsoft.Extensions.* (the .NET 10 servicing line shared by all modules). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <!-- Released on the dotnet/extensions line, not the runtime servicing line. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <!-- .NET runtime packages referenced directly to keep a patched version over the transitive one. -->
  <ItemGroup>
    <PackageVersion Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>

  <!-- gRPC: one Google.Protobuf for the gRPC facade and the demo viewer. -->
  <ItemGroup>
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
  </ItemGroup>

  <!-- Identity features: MFA, WebAuthn, password hashing, device detection, logging of the Web BFF. -->
  <ItemGroup>
    <PackageVersion Include="Fido2" Version="4.3.1" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="MyCSharp.HttpUserAgentParser" Version="3.1.6" />
    <PackageVersion Include="MyCSharp.HttpUserAgentParser.MemoryCache" Version="3.1.6" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!--
    Tests. AwesomeAssertions (Apache 2.0) replaces FluentAssertions, which is under a commercial licence from 8.0.
    xunit.runner.visualstudio 4.x still runs xunit v2 tests.
  -->
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!-- redb packages: the monorepo ProjectReferences, rewritten for the public repository. -->
  <ItemGroup>
    <PackageVersion Include="redb.Core" Version="4.4.0" />
    <PackageVersion Include="redb.Core.Pro" Version="4.4.0" />
    <PackageVersion Include="redb.MSSql" Version="4.4.0" />
    <PackageVersion Include="redb.MSSql.Pro" Version="4.4.0" />
    <PackageVersion Include="redb.Postgres" Version="4.4.0" />
    <PackageVersion Include="redb.Postgres.Pro" Version="4.4.0" />
    <PackageVersion Include="redb.Route" Version="4.4.0" />
    <PackageVersion Include="redb.Route.Amqp" Version="4.4.0" />
    <PackageVersion Include="redb.Route.Controllers" Version="4.4.0" />
    <PackageVersion Include="redb.Route.Core" Version="4.4.0" />
    <PackageVersion Include="redb.Route.Elasticsearch" Version="4.4.0" />
    <PackageVersion Include="redb.Route.Grpc" Version="4.4.0" />
    <PackageVersion Include="redb.Route.Http" Version="4.4.0" />
    <PackageVersion Include="redb.Route.IbmMq" Version="4.4.0" />
    <PackageVersion Include="redb.Route.Kafka" Version="4.4.0" />
    <PackageVersion Include="redb.Route.Ldap" Version="4.4.0" />
    <PackageVersion Include="redb.Route.Mail" Version="4.4.0" />
    <PackageVersion Include="redb.Route.MqttNet" Version="4.4.0" />
    <PackageVersion Include="redb.Route.RabbitMQ" Version="4.4.0" />
    <PackageVersion Include="redb.Route.Redis" Version="4.4.0" />
    <PackageVersion Include="redb.Route.Soap" Version="4.4.0" />
    <PackageVersion Include="redb.Route.Sql" Version="4.4.0" />
    <PackageVersion Include="redb.SQLite" Version="4.4.0" />
    <PackageVersion Include="redb.SQLite.Pro" Version="4.4.0" />
    <PackageVersion Include="redb.Tsak.Contracts" Version="4.4.0" />
    <PackageVersion Include="redb.Tsak.Core" Version="4.4.0" />
  </ItemGroup>
</Project>

